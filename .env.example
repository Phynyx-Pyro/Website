# ---------------------------------------------------------------------------
# PhynyxPro Website - Environment Variables
# Copy this file to `.env` and fill in real values before running the app.
# ---------------------------------------------------------------------------

# Canonical public URL used for metadata, sitemap, and robots output.
# The production brand domain is the safe default in source.
SITE_URL=https://phynyxpro.com

# GoHighLevel sub-account connection. Keep the token secret and server-side.
GHL_LOCATION_ID=
GHL_PRIVATE_INTEGRATION_TOKEN=
