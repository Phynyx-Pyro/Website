# ---------------------------------------------------------------------------
# PhynyxPro Website - Environment Variables
# Copy this file to `.env` and fill in real values before running the app.
# ---------------------------------------------------------------------------

# Canonical public URL used for metadata, sitemap, and robots output.
# The production brand domain is the safe default in source.
SITE_URL=https://phynyxpro.com

# Fail closed until verification, isolation and the recovery contract are ready.
# Enabling the legacy adapter alone does NOT implement repeat-safe recovery.
WEBSITE_CRM_DISPATCH_ENABLED=false
WEBSITE_EXTERNAL_TRACKING_ENABLED=false
WEBSITE_CRM_MODE=off
WEBSITE_VERIFICATION_ENABLED=false
WEBSITE_RECOVERY_DISPATCH_ENABLED=false
# Explicit exception: preserve this OPEN nurture opportunity while requalifying
# a newly verified assessment; never reset its stage/status/owner/value.
WEBSITE_RETURNING_NURTURE_APPROVED=false
WEBSITE_RETURNING_NURTURE_STAGE_ID=
# Bounded acceptance configuration is stored privately in Sites, never here:
# WEBSITE_ACCEPTANCE_CONTACT_ID, WEBSITE_CRM_TEST_EMAIL, WEBSITE_CRM_TEST_PHONE
# WEBSITE_ACCEPTANCE_WORKFLOWS_APPROVED / WEBSITE_TEST_SUPPRESSION_APPROVED
# must reflect reviewed workflow evidence, not substitute for it.

# GoHighLevel sub-account connection. Keep the token secret and server-side.
GHL_LOCATION_ID=DsRnzA2tcoiwklSgjBtR
GHL_PIPELINE_ID=usVVpz3ldoUD9OQQOv09
GHL_PIPELINE_STAGE_ID=ac4d559d-7669-47ab-ae9b-832b7d29225b
GHL_PRIVATE_INTEGRATION_TOKEN=
